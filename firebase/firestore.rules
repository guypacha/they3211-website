rules_version = '2';
// Accounts for the team website. Roles: student, mentor, admin. Guests need no account.
// Every account starts from a one-time invite code. Admins invite anyone; mentors invite students.
// Only an admin can change roles or disable accounts. The first admin is set by hand in the console.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().get('disabled', false) == false; }
    function isAdmin() { return active() && me().role == 'admin'; }
    function isStaff() { return active() && me().role in ['mentor', 'admin']; }
    function validUsername(u) { return u is string && u.matches('^[a-z0-9._-]{3,20}$'); }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 60; }
    function inv(code) { return get(/databases/$(database)/documents/invites/$(code)).data; }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isStaff());
      allow list: if isStaff();
      // Sign-up: one batch writes this doc, claims the invite and reserves the username.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'name', 'role', 'invite', 'createdAt'])
        && validUsername(request.resource.data.username) && validName(request.resource.data.name)
        && request.resource.data.createdAt == request.time
        && inv(request.resource.data.invite).usedBy == null
        && (inv(request.resource.data.invite).get('expiresAt', null) == null || request.time < inv(request.resource.data.invite).expiresAt)
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.usedBy == uid
        && request.resource.data.role == inv(request.resource.data.invite).role
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      // You may change your display name. Admins may change role or disable an account (not their own).
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) && validName(request.resource.data.name))
        || (isAdmin() && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'disabled'])
          && request.resource.data.role in ['student', 'mentor', 'admin']
          && request.resource.data.get('disabled', false) is bool);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if true;            // the sign-up form checks if a name is free
      allow list: if false;
      allow create: if signedIn() && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }

    match /invites/{code} {
      allow get: if true;            // the code itself is the secret (10 random characters)
      allow list: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['role', 'name', 'createdBy', 'createdAt', 'usedBy', 'expiresAt'])
        && (request.resource.data.role == 'student' || (isAdmin() && request.resource.data.role in ['mentor', 'admin']))
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd')
        && request.resource.data.usedBy == null;
      // Claimed exactly once, by the account being created in the same batch.
      allow update: if signedIn() && resource.data.usedBy == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
      allow delete: if isStaff() && resource.data.usedBy == null;
    }

    // Mission list (order, minimum seconds, which are licenses). Written by an admin from the "My account" page.
    match /config/missions {
      allow get: if true;
      allow write: if isAdmin();
    }

    // Training-ground progress, one doc per account. The rules decide what counts:
    // a mission saves only if the previous one is already done, at least `min` seconds after it was started,
    // with 1 to 3 stars. Licenses need a mentor's approval (the `lic` map), which only staff can write.
    function cat() { return get(/databases/$(database)/documents/config/missions).data; }
    function startOf(uid, k) { return get(/databases/$(database)/documents/progress/$(uid)/starts/$(k)).data.at; }
    function unlocked(m, k) { return k in cat().prev && (cat().prev[k] == '' || cat().prev[k] in m); }

    match /progress/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isStaff());
      allow list: if isStaff();
      allow create: if active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['m', 'lic', 'updatedAt'])
        && request.resource.data.m == {} && request.resource.data.lic == {} && request.resource.data.updatedAt == request.time;
      // A student finishing one mission (named in `last`).
      allow update: if (active() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['m', 'updatedAt', 'last'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.m.diff(resource.data.m).affectedKeys().hasOnly([request.resource.data.last])
          && validFinish(uid, request.resource.data.last, resource.data.m, request.resource.data.m[request.resource.data.last]))
        // A mentor approving (or taking back) one license, named in `licLast`.
        || (isStaff() && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lic', 'licLast'])
          && request.resource.data.lic.diff(resource.data.lic).affectedKeys().hasOnly([request.resource.data.licLast])
          && request.resource.data.licLast in cat().lic
          && (!(request.resource.data.licLast in request.resource.data.lic)
            || (request.resource.data.licLast in resource.data.m
              && request.resource.data.lic[request.resource.data.licLast] == { 'by': request.auth.uid, 'at': request.time })));
      allow delete: if false;

      function validFinish(uid, k, old, e) {
        return unlocked(old, k)
          && e.keys().hasOnly(['stars', 'n', 'at', 's'])
          && e.stars is int && e.stars >= 1 && e.stars <= 3 && (!(k in old) || e.stars >= old[k].stars)
          && e.n == (k in old ? old[k].n + 1 : 1)
          && e.at == request.time
          && e.s == startOf(uid, k)
          && request.time >= startOf(uid, k) + duration.value(cat().min[k], 's');
      }

      // "Started mission k" stamps, written when a mission opens. Only for unlocked missions.
      match /starts/{k} {
        allow get, list: if signedIn() && (request.auth.uid == uid || isStaff());
        allow create, update: if active() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
          && unlocked(get(/databases/$(database)/documents/progress/$(uid)).data.m, k);
        allow delete: if false;
      }
    }
  }
}
