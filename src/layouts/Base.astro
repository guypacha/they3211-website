---
import '../styles/global.css';
import { u, NAV, CONTACT, SOCIAL, type Lang } from '../lib';
interface Props { title: string; description: string; lang?: Lang; alt?: string }
const { title, description, lang = 'he', alt } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const bare = en ? path.replace(/^\/en/, '') || '/' : path;          // the same page without /en
const L = (p: string) => u((en ? '/en' : '') + p);
const other = alt ?? (en ? bare : '/en' + (bare === '/' ? '' : bare));  // the same page in the other language
const site = (Astro.site?.toString() ?? '').replace(/\/$/, '') + base;
const ogImage = `${site}/assets/og-${lang}.png`;
const fullTitle = title === 'בית' ? 'The Y Team 3211 · קבוצת הרובוטיקה של ירוחם' : title === 'Home' ? 'The Y Team 3211 · Robotics from Yeruham' : `${title} · The Y Team 3211`;
const ICON: Record<string, string> = {
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>',
  facebook: '<path d="M14 21v-8h3l.5-3.5H14V7.6c0-1 .3-1.6 1.7-1.6h1.9V2.9A25 25 0 0 0 14.8 2.8C12.2 2.8 10.5 4.4 10.5 7.3v2.2H7.5V13h3v8"/>',
  youtube: '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.2v5.6l5-2.8z" fill="currentColor"/>',
  github: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
  tba: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M12 4v16M4 12h16"/>',
};
---
<!doctype html>
<html lang={lang} dir={en ? 'ltr' : 'rtl'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="alternate" hreflang={en ? 'he' : 'en'} href={`${site}${other === '/' ? '/' : other}`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Y Team 3211" />
  <meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta property="og:locale" content={en ? 'en_US' : 'he_IL'} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#0F1B2D" />
  <link rel="icon" href={u('/assets/logo.jpg')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;800;900&family=Barlow+Condensed:wght@600;700&family=JetBrains+Mono:wght@500&display=swap" />
</head>
<body class={path === '/' || path === '/en' ? 'home' : 'inner'}>
  <a class="skip" href="#main">{en ? 'Skip to content' : 'דלג לתוכן'}</a>
  <nav id="nav"><div class="w">
    <a href={L('/')} aria-label={en ? 'The Y Team 3211, home' : 'The Y Team 3211, דף הבית'}><img src={u('/assets/logo.jpg')} alt="" width="58" height="34" /></a>
    <div class="links" id="links">
      {NAV.map(n => <a href={L(n.href)} aria-current={bare === n.href || bare.startsWith(n.href + '/') ? 'page' : undefined}>{n[lang]}</a>)}
    </div>
    <div class="right">
      <a class="lang" href={u(other)} hreflang={en ? 'he' : 'en'} lang={en ? 'he' : 'en'}>{en ? 'עברית' : 'EN'}</a>
      <a class="sup" href={L('/support')} aria-current={bare === '/support' ? 'page' : undefined}>{en ? 'Support us' : 'תמכו בנו'}</a>
      <a class="login" id="nav-login" href={L('/login')} data-account={L('/account')} aria-current={bare === '/login' || bare === '/account' ? 'page' : undefined}>{en ? 'Log in' : 'כניסה'}</a>
      <a class="join" href={L('/join')}>{en ? 'Join' : 'הצטרפו'}</a>
      <button class="menu" aria-expanded="false" aria-controls="links" id="menu">{en ? 'Menu' : 'תפריט'}</button>
    </div>
  </div></nav>
  {!(path === '/' || path === '/en') && <div class="ih" id="ih" aria-hidden="true">
    <canvas class="ih-sand"></canvas>
    {[0, 1, 2].map(i => <svg class={`ih-bird b${i}`} viewBox="0 0 24 10"><path d="M1 6q5-6 11 0q6-6 11 0" /></svg>)}
    <div class="ih-car">{[0, 1, 2].map(i => <svg viewBox="0 0 100 70" style={`width:${20 - i * 3}px`}><path d="M10 40C10 30 18 24 26 22C32 8 46 6 52 20C56 26 60 28 66 26C70 24 72 18 74 12C75 8 78 6 82 7L90 9C92 10 92 13 89 13L82 13C80 18 79 26 76 34C74 40 70 42 68 44L68 66H65L64 46H61L60 66H57L57 46C50 47 36 47 28 46L27 66H24L23 47H20L19 66H16L16 44C12 43 10 42 10 40Z" /></svg>)}</div>
  </div>}
  <main id="main"><slot /></main>
  <footer><div class="w">
    <div><b><bdi>The Y Team · FRC 3211</bdi></b>{CONTACT.address[lang]}</div>
    <div><b>{en ? 'Contact' : 'יצירת קשר'}</b><a class="m" style="font-size:14px" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></div>
    <div><b>{en ? 'Follow' : 'עקבו'}</b>
      <ul class="social">{SOCIAL.filter(s => s.url).map(s => <li><a href={s.url} rel="noopener" target="_blank" aria-label={s.label} title={s.label}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON[s.id]} /></a></li>)}</ul></div>
  </div></footer>
  <script>
    // Reveal on scroll (skipped for reduced motion); content is visible without JS.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const els = document.querySelectorAll<HTMLElement>('.rv, .page-head > *, .acc-card, .acc-side > *, .faq details, .two-links > a, .sec .head, .facts > div, .seasons > a, .paths > a, .ax > *, .spons > span, .robot, .tiers > div, .two > *, .shots > figure, .list li');
      const io = new IntersectionObserver(es => es.forEach(e => { if (!e.isIntersecting) return; const el = e.target as HTMLElement; el.classList.add('in'); io.unobserve(el);
        const n = el.querySelector<HTMLElement>('[data-count]'); if (n) { const to = +n.dataset.count!, from = to > 1000 ? to - 40 : 0, t0 = performance.now();
          const tick = (t: number) => { const k = Math.min(1, (t - t0) / 1100), e2 = 1 - Math.pow(1 - k, 3); n.textContent = String(Math.round(from + (to - from) * e2)); if (k < 1) requestAnimationFrame(tick); }; requestAnimationFrame(tick); } }), { rootMargin: '0px 0px -8% 0px' });
      els.forEach(el => { const i = el.parentElement ? [...el.parentElement.children].indexOf(el) : 0; el.classList.add('rv'); el.style.transitionDelay = `${Math.min(i, 6) * 80}ms`; io.observe(el); });
    }
    const b = document.getElementById('menu'), n = document.getElementById('nav');
    b?.addEventListener('click', () => { const o = n!.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
  </script>
<script is:inline>(function(){try{var a=JSON.parse(localStorage.getItem('y3211-account')||'null'),l=document.getElementById('nav-login');if(a&&a.name&&l){l.textContent=a.name;l.href=l.dataset.account;l.classList.add('in')}}catch(e){}})();</script>
<script>
  // inner pages: move the small desert scene under the page title, and blow some sand
  const ih = document.getElementById('ih'), ph = document.querySelector('.inner .page-head');
  if (ih && ph) {
    ph.prepend(ih);
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cv = ih.querySelector('canvas')!;
    if (!still) {
      const cx = cv.getContext('2d')!; let W = 0, H = 0, vis = true, t = 0;
      const fit = () => { const r = cv.getBoundingClientRect(); W = cv.width = r.width * devicePixelRatio; H = cv.height = r.height * devicePixelRatio; };
      fit(); addEventListener('resize', fit);
      const g = Array.from({ length: innerWidth < 700 ? 40 : 90 }, () => ({ x: Math.random(), y: 0.55 + Math.random() * 0.45, v: 0.0005 + Math.random() * 0.0014, s: 0.6 + Math.random() * 1.4, p: Math.random() * 6 }));
      new IntersectionObserver(e => { vis = e[0].isIntersecting; if (vis) requestAnimationFrame(draw); }).observe(cv);
      function draw() { if (!vis) return; t++; cx.clearRect(0, 0, W, H); const gust = 1 + 0.8 * Math.max(0, Math.sin(t / 240));
        for (const q of g) { q.x -= q.v * gust; if (q.x < -0.02) { q.x = 1.02; q.y = 0.55 + Math.random() * 0.45; }
          cx.fillStyle = `rgba(214,190,140,${0.14 + q.s * 0.1})`; cx.fillRect(q.x * W, (q.y + Math.sin(t / 50 + q.p) * 0.006) * H, q.s * devicePixelRatio, q.s * devicePixelRatio * 0.7); }
        requestAnimationFrame(draw); }
      requestAnimationFrame(draw);
    }
  }
</script>
</body>
</html>
