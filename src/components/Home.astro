---
import Base from '../layouts/Base.astro';
import Photo from './Photo.astro';
import { getCollection } from 'astro:content';
import { u } from '../lib';
interface Props { lang?: 'he' | 'en' }
const { lang = 'he' } = Astro.props;
const en = lang === 'en';
const L = (p: string) => u((en ? '/en' : '') + p);
const robots = (await getCollection('robots')).sort((a, b) => b.data.year - a.data.year).slice(0, 4);
// Sponsors strip: add logos to public/assets/partners and list them here; the strip scrolls on its own.
const sponsors: { src?: string; he: string; en: string }[] = [
  { src: '/assets/partners/yeruham.png', he: 'המועצה המקומית ירוחם', en: 'Yeruham Local Council' },
  { src: '/assets/partners/science-center.png', he: 'מרכז מדעים ירוחם', en: 'Yeruham Science Center' },
  { he: '[לוגו]', en: '[logo]' }, { he: '[לוגו]', en: '[logo]' }, { he: '[לוגו]', en: '[logo]' }, { he: '[לוגו]', en: '[logo]' },
];
// Hero slideshow: put photos in public/photos and set src, e.g. '/photos/hero-1.jpg'.
const slides: { src?: string; he: string; en: string }[] = [
  { he: 'תמונה במסך מלא: הרובוט במקצה', en: 'Full-screen photo: the robot in a match' },
  { he: 'תמונה במסך מלא: הסדנה במחסן 52', en: 'Full-screen photo: the workshop in Warehouse 52' },
  { he: 'תמונה במסך מלא: הקבוצה בתחרות', en: 'Full-screen photo: the team at an event' },
];
const HE = {
  title: 'בית', desc: 'קבוצת הרובוטיקה של תלמידי ירוחם, שנוסדה בשנת 2009 ומתחרה בליגת FRC מאז 2010.', arrow: '←',
  slidesLbl: 'תמונות מהקבוצה', dotsLbl: 'בחירת תמונה', dot: 'תמונה',
  h1: 'רובוטים מירוחם.',
  lead: '<bdi>The Y Team</bdi> היא קבוצת הרובוטיקה של תלמידי ירוחם, שנוסדה בשנת 2009 ומתחרה בליגת <bdi>FRC</bdi> מאז 2010. עשרים תלמידים, חמישה מנטורים ורובוט חדש בכל עונה.',
  join: 'הצטרפו לקבוצה', support: 'תמכו בנו',
  f1: 'שנת הקמה', f2: 'תלמידים מכיתות ט׳ עד י״ב', f3: 'מנטורים', f4: 'מספר המחסן של הסדנה',
  robots: 'הרובוטים', allRobots: 'כל הרובוטים', robotOf: 'הרובוט של', robotPh: 'תמונת רובוט',
  p1l: 'לתלמידים ולהורים', p1h: 'הצטרפו לקבוצה', p1p: 'כיתות ט׳ עד י״ב מכל בתי הספר בירוחם. ההרשמה נפתחת במאי ובאוקטובר, ולא צריך ניסיון.', p1a: 'איך מצטרפים',
  p2l: 'לחברות ולתורמים', p2h: 'תמכו בנו', p2p: 'התמיכה שלכם קונה ציוד, מממנת נסיעות ותחרויות ומשפצת את הסדנה שלנו.', p2a: 'איך תומכים',
  p3l: 'לחברי הקבוצה', p3h: 'מגרש האימונים', p3p: 'כאן תלמידים חדשים לומדים חשמל, מכניקה ואסטרטגיה דרך משימות קצרות, ובסוף כל נושא מקבלים רישיון.', p3a: 'לנסות משימה',
  axl: 'תוכנה שבנינו', axp: 'אפליקציה לניהול קבוצת רובוטיקה, במקום הגיליון שגדל לשונית אחרי לשונית. אנחנו משתמשים בה כל יום, וגם קבוצת <bdi>DaVinci 4744</bdi>.',
  axli: [['נוכחות', 'לפי מחלקות'], ['אימונים והסמכות', 'מי מוסמך למה'], ['מלאי, הזמנות ותקציב', 'חי ומשותף'], ['שעות קהילה', 'לכל תלמיד']],
  axa: 'על האפליקציה', axalt: 'מסך הבית של AttendX עם נתוני דוגמה', axcap: 'מסך הבית, עם נתוני דוגמה',
  th: 'תודה לתומכים שלנו', thj: 'הצטרפו אליהם', thl: 'התומכים שלנו',
};
const EN: typeof HE = {
  title: 'Home', desc: 'The robotics team of Yeruham high school students, founded in 2009 and competing in FRC since 2010.', arrow: '→',
  slidesLbl: 'Team photos', dotsLbl: 'Choose a photo', dot: 'Photo',
  h1: 'Robots from Yeruham.',
  lead: 'The Y Team is the robotics team of high school students in Yeruham, in the Negev desert, founded in 2009 and competing in FRC since 2010. Twenty students, five mentors and a new robot every season.',
  join: 'Join the team', support: 'Support us',
  f1: 'Founded', f2: 'Students, grades 9 to 12', f3: 'Mentors', f4: 'Our workshop warehouse',
  robots: 'The robots', allRobots: 'All robots', robotOf: 'Robot of', robotPh: 'Robot photo',
  p1l: 'Students and parents', p1h: 'Join the team', p1p: 'Grades 9 to 12 from every school in Yeruham. Registration opens in May and October, and no experience is needed.', p1a: 'How to join',
  p2l: 'Companies and donors', p2h: 'Support us', p2p: 'Your support buys parts, pays for travel and competitions, and renovates our workshop.', p2a: 'How to support',
  p3l: 'Team members', p3h: 'Training ground', p3p: 'New students learn electrical, mechanical and strategy through short missions, with a license at the end of each topic.', p3a: 'Try a mission',
  axl: 'Software we built', axp: 'An app for running a robotics team, instead of the spreadsheet that keeps growing tabs. We use it every day, and so does team DaVinci 4744.',
  axli: [['Attendance', 'by department'], ['Training and certifications', 'who is certified for what'], ['Inventory, orders and budget', 'live and shared'], ['Community hours', 'per student']],
  axa: 'About the app', axalt: 'AttendX home screen with sample data', axcap: 'Home screen, with sample data',
  th: 'Thank you to our supporters', thj: 'Join them', thl: 'Our supporters',
};
const t = en ? EN : HE;
---
<Base title={t.title} description={t.desc} lang={lang} alt={en ? "/" : "/en"}>
  <header class="h2g photo">
    <div class="slides" aria-roledescription={en ? "carousel" : "מצגת"} aria-label={t.slidesLbl}>
      {slides.map((sl, i) => (
        <div class={`slide${i === 0 ? ' on' : ''}`} aria-hidden={i === 0 ? 'false' : 'true'}>
          {sl.src ? <img src={u(sl.src)} alt={sl[lang]} /> : <span class="ph" style="align-items:start;padding-top:22%">{sl[lang]}</span>}
        </div>))}
    </div>
    <div class="dots" role="group" aria-label={t.dotsLbl}>
      {slides.map((_, i) => <button type="button" aria-label={`${t.dot} ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'} data-i={i}></button>)}
    </div>
    <div class="w inner">
      <div class="num" aria-hidden="true">3211</div>
      <div class="txt">
        <h1>{t.h1}</h1>
        <p set:html={t.lead} />
        <div class="cta"><a class="link" href={L('/join')}>{t.join} {t.arrow}</a><a class="link q" style="color:var(--ink)" href={L('/support')}>{t.support} {t.arrow}</a></div>
      </div>
      <span class="m coord">30.99°N 34.93°E · YERUHAM</span>
    </div>
    <svg class="birds" viewBox="0 0 160 60" aria-hidden="true"><path d="M8 30q6-7 12 0q6-7 12 0"/><path d="M52 14q4-5 8 0q4-5 8 0"/><path d="M96 34q5-6 10 0q5-6 10 0"/><path d="M128 20q3-4 6 0q3-4 6 0"/></svg>
    <canvas class="sand" aria-hidden="true"></canvas>
    <div class="caravan" aria-hidden="true">{[0, 1, 2].map(i => <svg viewBox="0 0 100 70" style={`width:${22 - i * 3}px`}><use href="#camel-shape" /></svg>)}</div>
    <svg class="devil" viewBox="0 0 60 90" aria-hidden="true"><ellipse cx="30" cy="12" rx="24" ry="6"/><ellipse cx="30" cy="30" rx="17" ry="5"/><ellipse cx="30" cy="48" rx="11" ry="4"/><ellipse cx="30" cy="64" rx="6" ry="3"/><ellipse cx="30" cy="78" rx="3" ry="2"/></svg>
    <svg class="ridge" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path class="back" d="M0 120V70L90 62 160 66 230 48 320 46 360 58 470 60 540 40 640 38 700 52 820 56 900 44 1010 42 1060 30 1150 28 1200 46 1300 50 1380 62 1440 58V120Z"/>
      <path class="front" d="M0 120V92C120 86 200 80 300 84L380 72 470 70 520 82C620 90 760 88 860 80L930 66 1010 64 1060 76C1160 86 1300 84 1440 78V120Z"/>
    </svg>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><path id="camel-shape" d="M10 40C10 30 18 24 26 22C32 8 46 6 52 20C56 26 60 28 66 26C70 24 72 18 74 12C75 8 78 6 82 7L90 9C92 10 92 13 89 13L82 13C80 18 79 26 76 34C74 40 70 42 68 44L68 66H65L64 46H61L60 66H57L57 46C50 47 36 47 28 46L27 66H24L23 47H20L19 66H16L16 44C12 43 10 42 10 40Z"/></defs></svg>
    <svg class="oasis" viewBox="0 0 120 70" aria-hidden="true">
      <ellipse class="water" cx="62" cy="64" rx="40" ry="5"/>
      <g class="palm" transform="translate(30 6)"><path d="M20 60C21 45 19 30 22 18" stroke-width="3"/><path d="M22 18C14 12 6 14 1 21M22 18C16 8 9 6 3 9M22 18C26 8 34 6 39 10M22 18C30 14 36 16 40 23M22 18C22 10 25 4 29 2"/></g>
      <g class="palm p2" transform="translate(66 18) scale(.75)"><path d="M20 60C21 45 19 30 22 18" stroke-width="3"/><path d="M22 18C14 12 6 14 1 21M22 18C16 8 9 6 3 9M22 18C26 8 34 6 39 10M22 18C30 14 36 16 40 23M22 18C22 10 25 4 29 2"/></g>
    </svg>
    <svg class="camel" viewBox="0 0 100 70" aria-hidden="true"><g transform="matrix(-1 0 0 1 100 0)"><path d="M10 40C10 30 18 24 26 22C32 8 46 6 52 20C56 26 60 28 66 26C70 24 72 18 74 12C75 8 78 6 82 7L90 9C92 10 92 13 89 13L82 13C80 18 79 26 76 34C74 40 70 42 68 44L68 66H65L64 46H61L60 66H57L57 46C50 47 36 47 28 46L27 66H24L23 47H20L19 66H16L16 44C12 43 10 42 10 40Z"/><path d="M10 38C7 42 6 48 7 52" fill="none" stroke-width="1.6"/></g></svg>
  </header>
  <section class="band-blue"><div class="w">
    <div class="facts">
      <div><b data-count="2009">2009</b><span class="lbl">{t.f1}</span></div>
      <div><b data-count="20">20</b><span class="lbl">{t.f2}</span></div>
      <div><b data-count="5">5</b><span class="lbl">{t.f3}</span></div>
      <div><b data-count="52">52</b><span class="lbl">{t.f4}</span></div>
    </div>
  </div></section>
  <div class="w">

    <section class="sec">
      <div class="head"><h2>{t.robots}</h2><a class="link q" href={L('/robots')}>{t.allRobots} {t.arrow}</a></div>
      <div class="seasons">
        {robots.map(r => (
          <a href={L('/robots') + '#y' + r.data.year}>
            <Photo src={r.data.photo} alt={`${t.robotOf} ${r.data.year}`} ratio="4/5" label={t.robotPh} />
            <b>{en ? r.data.name.replace("[שם הרובוט]", "[robot name]") : r.data.name}</b><span class="m">{r.data.year} · {r.data.game}</span>
          </a>))}
      </div>
    </section>

  </div>
  <section class="band band-light"><div class="w"><section class="sec" style="padding-top:72px"><div class="paths">
      <a href={L('/join')}><span class="lbl acc">{t.p1l}</span><h3>{t.p1h}</h3><p>{t.p1p}</p><span class="link">{t.p1a} {t.arrow}</span></a>
      <a href={L('/support')}><span class="lbl acc">{t.p2l}</span><h3>{t.p2h}</h3><p>{t.p2p}</p><span class="link">{t.p2a} {t.arrow}</span></a>
      <a href={L('/train')}><span class="lbl acc">{t.p3l}</span><h3>{t.p3h}</h3><p>{t.p3p}</p><span class="link">{t.p3a} {t.arrow}</span></a>
    </div></section></div></section>
  <div class="w">
    <section class="sec ax">
      <div><span class="lbl acc">{t.axl}</span><h2><bdi>AttendX</bdi></h2>
        <p set:html={t.axp} />
        <ul>{t.axli.map(([a, b]) => <li>{a}<span>{b}</span></li>)}</ul>
        <a class="link" href={L('/attendx')}>{t.axa} {t.arrow}</a></div>
      <figure style="margin:0"><img src={u('/assets/dashboard.jpg')} alt={t.axalt} width="800" height="515" loading="lazy" /><figcaption><span>{t.axcap}</span><span class="m">REACT · FIREBASE</span></figcaption></figure>
    </section>

  </div>
  <section class="band band-light" style="margin-top:72px;margin-bottom:24px"><div class="w"><section class="sec" style="padding-top:72px"><div class="head"><h2>{t.th}</h2><a class="link q" href={L('/support')}>{t.thj} {t.arrow}</a></div>
      <div class="marquee" aria-label={t.thl}><div class="mq-track">
        {[0, 1].map(copy => (
          <ul class="mq-set" aria-hidden={copy === 1 ? 'true' : undefined}>
            {sponsors.map(sp => <li class={sp.src ? 'logo' : ''}>{sp.src ? <img src={u(sp.src)} alt={copy ? '' : sp[lang]} height="56" loading="lazy" /> : sp[lang]}</li>)}
          </ul>))}
      </div></div></section></div></section>
</Base>
<script>
  const root = document.querySelector('.h2g');
  const slides = [...document.querySelectorAll('.slide')], dots = [...document.querySelectorAll('.dots button')];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cur = 0, timer: number | undefined;
  const show = (i: number) => { cur = (i + slides.length) % slides.length;
    slides.forEach((s, k) => { s.classList.toggle('on', k === cur); s.setAttribute('aria-hidden', String(k !== cur)); });
    dots.forEach((d, k) => d.setAttribute('aria-pressed', String(k === cur))); };
  const play = () => { if (!still && slides.length > 1) { clearInterval(timer); timer = window.setInterval(() => show(cur + 1), 5500); } };
  dots.forEach(d => d.addEventListener('click', () => { show(+d.dataset.i!); play(); }));
  root?.addEventListener('mouseenter', () => clearInterval(timer)); root?.addEventListener('mouseleave', play);
  play();
  // blowing sand: a few hundred grains drifting with the wind, paused when the hero is off screen
  const cv = document.querySelector<HTMLCanvasElement>('.sand');
  if (cv && !still) {
    const cx = cv.getContext('2d')!; let W = 0, H = 0, vis = true, t = 0;
    const fit = () => { const r = cv.getBoundingClientRect(); W = cv.width = r.width * devicePixelRatio; H = cv.height = r.height * devicePixelRatio; };
    fit(); addEventListener('resize', fit);
    const N = innerWidth < 700 ? 70 : 160;
    const g = Array.from({ length: N }, () => ({ x: Math.random(), y: 0.45 + Math.random() * 0.55, v: 0.0006 + Math.random() * 0.0016, s: 0.6 + Math.random() * 1.6, p: Math.random() * 6 }));
    new IntersectionObserver(e => { vis = e[0].isIntersecting; if (vis) requestAnimationFrame(draw); }).observe(cv);
    function draw() { if (!vis) return; t += 1; cx.clearRect(0, 0, W, H);
      const gust = 1 + 0.8 * Math.max(0, Math.sin(t / 240));
      for (const q of g) { q.x -= q.v * gust; if (q.x < -0.02) { q.x = 1.02; q.y = 0.45 + Math.random() * 0.55; }
        const y = (q.y + Math.sin(t / 50 + q.p) * 0.006) * H;
        cx.fillStyle = `rgba(214,190,140,${0.18 + q.s * 0.12})`; cx.fillRect(q.x * W, y, q.s * devicePixelRatio, q.s * devicePixelRatio * 0.7); }
      requestAnimationFrame(draw); }
    requestAnimationFrame(draw);
  }
  // camel walks and birds drift as you scroll
  const camel = document.querySelector<SVGElement>('.camel'), back = document.querySelector<SVGElement>('.ridge .back');
  if (!still && camel) { let q = false; addEventListener('scroll', () => { if (q) return; q = true; requestAnimationFrame(() => { const y = Math.min(scrollY, 600);
    camel.style.transform = `translateX(${-y * 0.25}px)`; back?.setAttribute('transform', `translate(${y * 0.08} 0)`); q = false; }); }, { passive: true }); }
</script>
<style is:global>
.h2g{min-height:min(86vh,760px);display:flex;align-items:flex-end;position:relative;margin-top:-68px;padding-top:68px}
.h2g::after{content:"";position:absolute;inset:40% 0 0 0;background:linear-gradient(transparent,rgba(15,27,45,.95))}
.h2g .inner{position:relative;z-index:2;width:100%;display:grid;grid-template-columns:auto 1fr;gap:48px;align-items:end;padding-block:0 120px}
.num{font-family:var(--n);font-weight:600;font-size:clamp(120px,19vw,260px);line-height:.78;letter-spacing:-.01em;direction:ltr}
.h2g h1{font-size:clamp(28px,3.2vw,42px);font-weight:700;letter-spacing:-.01em;margin:0 0 12px}
.h2g p{color:#D5DEE8;margin:0 0 24px;max-width:44ch}.cta{display:flex;gap:28px;flex-wrap:wrap}
.coord{position:absolute;top:-40px;left:max(24px,env(safe-area-inset-left));color:var(--soft)}
.slides{position:absolute;inset:0}
.slide{position:absolute;inset:0;opacity:0;transition:opacity 1.4s ease}
.slide.on{opacity:1}
.slide img{width:100%;height:100%;object-fit:cover;transform:scale(1.06);transition:transform 7s ease-out}
.slide.on img{transform:scale(1)}
.slide:nth-child(2){background:#1C2E47}.slide:nth-child(3){background:#203450}
.dots{position:absolute;z-index:3;bottom:132px;left:max(24px,env(safe-area-inset-left));display:flex;gap:4px}
.dots button{width:28px;height:28px;border:0;background:none;padding:0;display:grid;place-items:center}
.dots button::after{content:"";width:8px;height:8px;border-radius:999px;background:var(--soft);opacity:.5;transition:width .3s,opacity .3s}
.dots button[aria-pressed="true"]::after{width:22px;opacity:1;background:var(--ink)}
.sand{position:absolute;inset:0;width:100%;height:100%;z-index:1;pointer-events:none}
.caravan{position:absolute;bottom:62px;left:-80px;z-index:1;display:flex;gap:6px;align-items:flex-end;animation:caravan 70s linear infinite}
.caravan svg{fill:#1A2B44;transform:scaleX(-1)}
@keyframes caravan{from{transform:translateX(calc(100vw + 80px))}to{transform:translateX(0)}}
.devil{position:absolute;bottom:44px;left:20%;width:34px;z-index:1;fill:none;stroke:#D6BE8C;stroke-width:1.4;opacity:0;animation:devil 16s ease-in-out infinite}
.devil ellipse{animation:wob 1.1s ease-in-out infinite alternate}
.devil ellipse:nth-child(2){animation-delay:-.3s}.devil ellipse:nth-child(3){animation-delay:-.6s}.devil ellipse:nth-child(4){animation-delay:-.9s}
@keyframes wob{from{transform:translateX(-3px)}to{transform:translateX(3px)}}
@keyframes devil{0%{opacity:0;transform:translateX(0)}15%{opacity:.45}70%{opacity:.4}85%,100%{opacity:0;transform:translateX(220px)}}
.oasis{position:absolute;bottom:26px;right:11%;width:120px;z-index:1}
.oasis .palm{fill:none;stroke:var(--bg);stroke-width:2.6;stroke-linecap:round;transform-box:fill-box;transform-origin:bottom center}
.oasis .palm path+path{animation:sway 5s ease-in-out infinite alternate;transform-box:fill-box;transform-origin:bottom center}
.oasis .p2 path+path{animation-delay:-2s}
@keyframes sway{from{transform:rotate(-3deg)}to{transform:rotate(3deg)}}
.oasis .water{fill:#2A5A86;opacity:.55;animation:shimmer 3.5s ease-in-out infinite alternate}
@keyframes shimmer{from{opacity:.35;rx:38}to{opacity:.7;rx:42}}
.marquee{overflow:hidden;direction:ltr;-webkit-mask:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
.mq-track{display:flex;width:max-content;animation:mq 32s linear infinite}
.marquee:hover .mq-track{animation-play-state:paused}
.mq-set{display:flex;gap:20px;padding:0 10px 0 10px;margin:0;list-style:none}
.mq-set li{background:#fff;border-radius:999px;padding:14px 26px;display:flex;align-items:center;min-height:76px;color:var(--dim);white-space:nowrap}
.mq-set li.logo{padding:10px 26px}.mq-set img{height:56px;width:auto;display:block}
@keyframes mq{to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.mq-track{animation:none;flex-wrap:wrap}.mq-set[aria-hidden]{display:none}.caravan,.devil{display:none}}
@media(max-width:860px){.oasis{right:4%;width:84px;bottom:28px}.caravan{bottom:58px}}
.ridge{position:absolute;left:0;right:0;bottom:-1px;width:100%;height:120px;z-index:1}
.ridge .back{fill:#1A2B44}.ridge .front{fill:var(--bg)}
.camel{position:absolute;bottom:31px;left:48%;width:54px;z-index:1;fill:var(--bg);stroke:var(--bg)}
.birds{position:absolute;top:18%;right:12%;width:150px;z-index:1;fill:none;stroke:var(--soft);stroke-width:1.6;stroke-linecap:round;opacity:.7;animation:drift 18s ease-in-out infinite alternate}
@keyframes drift{to{transform:translate(-40px,8px)}}
@media(max-width:860px){.h2g .inner{grid-template-columns:1fr;gap:12px}.coord{position:static}}
</style>
