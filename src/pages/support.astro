---
import Base from '../layouts/Base.astro';
import { CONTACT } from '../lib';
---
<Base title="תמכו בנו" description="איך לתמוך בקבוצת הרובוטיקה של ירוחם, ומה התמיכה מאפשרת.">
  <div class="w">
    <header class="page-head"><span class="lbl">לחברות ולתורמים</span><h1>כל רובוט שלנו נבנה בזכות מישהו שהאמין בתלמידים של ירוחם.</h1>
      <p>כל תרומה הולכת ישר לסדנה, לתחרויות ולתלמידים.</p></header>
    <section class="sec"><div class="head"><h2>לאן הכסף הולך</h2></div>
      <ul class="list"><li>ציוד וחלקים<span>מנועים, בקרים, אלומיניום וחומרי הדפסה</span></li><li>תחרויות<span>דמי השתתפות ונסיעות</span></li><li>הסדנה<span>שיפוץ הסדנה באזור התעשייה</span></li><li>גיוס תלמידים<span>עוד תלמידים מכל בתי הספר בירוחם</span></li><li>קהילה<span>הדגמות ופעילויות בעיר</span></li></ul></section>
    <section class="sec"><div class="head"><h2>חבילות חסות</h2><span class="lbl">[סכומים ממתינים לאישור]</span></div>
      <div class="tiers">
        <div><span class="lbl">תומך</span><b>[ ]</b><p style="color:var(--soft);margin:0">לוגו באתר ותודה ברשתות.</p></div>
        <div><span class="lbl">שותף</span><b>[ ]</b><p style="color:var(--soft);margin:0">לוגו על הרובוט ועל חולצות הקבוצה.</p></div>
        <div><span class="lbl">שותף ראשי</span><b>[ ]</b><p style="color:var(--soft);margin:0">שם על הרובוט, ביקור בסדנה והדגמה אצלכם.</p></div>
      </div></section>
    <section class="sec two"><div><h2 style="font-size:30px;margin:0 0 12px">בואו נדבר</h2><p style="color:var(--soft)">נשמח להזמין אתכם לסדנה, להראות את הרובוט ולהכיר את התלמידים.</p></div>
      <div><ul class="list"><li>איש קשר<span>לירון גורי</span></li><li>מייל<span class="m" style="font-size:14px">{CONTACT.email}</span></li></ul>
        <p style="margin-top:20px"><a class="btn" href={`mailto:${CONTACT.email}?subject=חסות`}>כתבו לנו</a></p></div></section>
  </div>
</Base>
