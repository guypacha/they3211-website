---
import Base from '../layouts/Base.astro';
import TeamTabs from '../components/TeamTabs.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib';
---
<Base title="הקבוצה" description="מי אנחנו: קבוצת הרובוטיקה של תלמידי ירוחם, מאז 2009.">
  <div class="w">
    <header class="page-head"><span class="lbl">הקבוצה</span><h1>עשרים תלמידים, חמישה מנטורים, סדנה אחת בירוחם.</h1>
      <p>הקבוצה נוסדה בירוחם בשנת <bdi>2009</bdi>, ושנה אחר כך עלתה לתחרות הראשונה שלה. מאז הגענו שלוש פעמים לאליפות העולם (<bdi>2016, 2017, 2019</bdi>), זכינו בפרס יו״ר בשתי עונות ובפרס ההשפעה בעונת <bdi>2023</bdi>. היום יש בקבוצה עשרים תלמידים מכיתות ט׳ עד י״ב וחמישה מנטורים, ובכל עונה הם בונים רובוט חדש בסדנה שלנו במחסן 52.</p><TeamTabs cur="team" /></header>
    <section class="sec two">
      <div class="prose"><h2 style="margin-top:0">מה זה <bdi>FRC</bdi>?</h2>
        <p><bdi>FIRST Robotics Competition</bdi> היא תחרות רובוטיקה בינלאומית לתלמידי תיכון. בכל ינואר מתפרסם משחק חדש, ולקבוצות יש כמה שבועות לתכנן ולבנות רובוט שמשחק אותו. אחר כך מתחרים מול קבוצות מכל העולם.</p>
        <h2>איך הקבוצה בנויה</h2>
        <ul class="list"><li>מכניקה<span>תכנון, ייצור והרכבה</span></li><li>חשמל<span>חיווט, בקרים וסוללות</span></li><li>תכנות<span><bdi>Java</bdi> עם <bdi>WPILib</bdi></span></li><li>אסטרטגיה<span>ניתוח משחק וסקאוטינג</span></li><li>מדיה ועסקים<span>תוכן, ספונסרים וקהילה</span></li></ul>
      </div>
      <Photo alt="הקבוצה בסדנה" ratio="4/3" label="תמונה של כל הקבוצה" />
    </section>
    <section class="sec two-links"><a class="tl-card" href={u('/team/mentors')}><span class="lbl acc">המנטורים</span><b>האנשים שמלווים את הקבוצה ←</b></a><a class="tl-card" href={u('/team/structure')}><span class="lbl acc">מבנה הקבוצה</span><b>הנהלה, קפטנים וחמש מחלקות ←</b></a></section>
    <section class="sec two"><div><h2 style="font-size:30px;margin:0 0 12px">הסדנה: מחסן 52</h2><p class="muted" style="color:var(--soft)">באזור התעשייה של ירוחם. שם מתכננים, מדפיסים, חותכים, מחווטים ובודקים. יש בסדנה מדפסות תלת־ממד של <bdi>Bambu Lab</bdi>, ומדפסת <bdi>Markforged</bdi> לחלקים חזקים מסיבי פחמן.</p></div>
      <Photo alt="הסדנה במחסן 52" ratio="16/9" label="תמונה מהסדנה" /></section>
  </div>
</Base>
